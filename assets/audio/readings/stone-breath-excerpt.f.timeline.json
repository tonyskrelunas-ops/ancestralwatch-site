{
 "slug": "stone-breath-excerpt",
 "audio": "/assets/audio/readings/stone-breath-excerpt.f.m4a",
 "voice": "feminine",
 "sentences": [
  {
   "p": 0,
   "s": 0,
   "start": 0.3,
   "end": 1.23,
   "text": "Stone Breath."
  },
  {
   "p": 0,
   "s": 1,
   "start": 1.55,
   "end": 3.45,
   "text": "The Stone Breath — The Whole Practice."
  },
  {
   "p": 1,
   "s": 0,
   "start": 4.5,
   "end": 5.57,
   "text": "Close your eyes."
  },
  {
   "p": 2,
   "s": 0,
   "start": 6.62,
   "end": 9.05,
   "text": "You are standing in the mountains, beside a stream."
  },
  {
   "p": 2,
   "s": 1,
   "start": 9.37,
   "end": 12.56,
   "text": "Let the place build itself around you — do not force it, let it come."
  },
  {
   "p": 2,
   "s": 2,
   "start": 12.88,
   "end": 16.19,
   "text": "Feel the wind first, the small breeze moving across your face."
  },
  {
   "p": 2,
   "s": 3,
   "start": 16.51,
   "end": 18.83,
   "text": "Now the sounds: the birds, somewhere above you."
  },
  {
   "p": 2,
   "s": 4,
   "start": 19.15,
   "end": 21.07,
   "text": "The water, working over the stones."
  },
  {
   "p": 2,
   "s": 5,
   "start": 21.39,
   "end": 22.19,
   "text": "The leaves."
  },
  {
   "p": 2,
   "s": 6,
   "start": 22.51,
   "end": 23.19,
   "text": "The grass."
  },
  {
   "p": 2,
   "s": 7,
   "start": 23.51,
   "end": 29.05,
   "text": "And underneath all of it, the quiet — the great quiet that holds the sounds the way the sky holds the birds."
  },
  {
   "p": 3,
   "s": 0,
   "start": 30.1,
   "end": 33.19,
   "text": "There is a stream at your feet, and in the stream there are pebbles."
  },
  {
   "p": 3,
   "s": 1,
   "start": 33.51,
   "end": 35.2,
   "text": "See them under the moving water."
  },
  {
   "p": 4,
   "s": 0,
   "start": 36.25,
   "end": 38.45,
   "text": "Now look into the water and find your pebble."
  },
  {
   "p": 4,
   "s": 1,
   "start": 38.77,
   "end": 40.7,
   "text": "Not any pebble — the one that calls to you."
  },
  {
   "p": 4,
   "s": 2,
   "start": 41.02,
   "end": 42.03,
   "text": "You will know it."
  },
  {
   "p": 4,
   "s": 3,
   "start": 42.35,
   "end": 43.17,
   "text": "Pick it up."
  },
  {
   "p": 5,
   "s": 0,
   "start": 44.22,
   "end": 45.61,
   "text": "Breathe in — four counts."
  },
  {
   "p": 5,
   "s": 1,
   "start": 45.93,
   "end": 46.89,
   "text": "Hold — four."
  },
  {
   "p": 5,
   "s": 2,
   "start": 47.21,
   "end": 48.68,
   "text": "Breathe out, slow — six."
  },
  {
   "p": 5,
   "s": 3,
   "start": 49.0,
   "end": 49.96,
   "text": "Hold — four."
  },
  {
   "p": 6,
   "s": 0,
   "start": 51.01,
   "end": 52.03,
   "text": "Five rounds."
  },
  {
   "p": 6,
   "s": 1,
   "start": 52.35,
   "end": 53.42,
   "text": "Take your time."
  },
  {
   "p": 6,
   "s": 2,
   "start": 53.74,
   "end": 55.13,
   "text": "There is nowhere to be."
  },
  {
   "p": 6,
   "s": 3,
   "start": 55.45,
   "end": 57.04,
   "text": "This is the place you were going."
  },
  {
   "p": 7,
   "s": 0,
   "start": 58.09,
   "end": 59.02,
   "text": "Stone Breath."
  },
  {
   "p": 7,
   "s": 1,
   "start": 59.34,
   "end": 60.26,
   "text": "Chapter 2."
  },
  {
   "p": 7,
   "s": 2,
   "start": 60.58,
   "end": 61.2,
   "text": "The Book."
  },
  {
   "p": 8,
   "s": 0,
   "start": 62.25,
   "end": 63.97,
   "text": "She saw him before he saw her."
  },
  {
   "p": 9,
   "s": 0,
   "start": 65.02,
   "end": 72.01,
   "text": "The bus from Vilnius pulled up to a dusty village shelter, and a man stepped off holding a cardboard box wrapped in a woven blanket."
  },
  {
   "p": 9,
   "s": 1,
   "start": 72.33,
   "end": 77.08,
   "text": "He stood there for a moment, looking around like he was waiting for the ground to tell him where to go."
  },
  {
   "p": 10,
   "s": 0,
   "start": 78.13,
   "end": 80.66,
   "text": "Austėja watched from the heritage center window."
  },
  {
   "p": 10,
   "s": 1,
   "start": 80.98,
   "end": 83.13,
   "text": "She'd seen a lot of visitors over the years."
  },
  {
   "p": 10,
   "s": 2,
   "start": 83.45,
   "end": 84.8,
   "text": "This one was different."
  },
  {
   "p": 10,
   "s": 3,
   "start": 85.12,
   "end": 86.27,
   "text": "Tired, she thought."
  },
  {
   "p": 10,
   "s": 4,
   "start": 86.59,
   "end": 87.71,
   "text": "Not in the body."
  },
  {
   "p": 10,
   "s": 5,
   "start": 88.03,
   "end": 88.88,
   "text": "In the soul."
  },
  {
   "p": 11,
   "s": 0,
   "start": 89.93,
   "end": 93.77,
   "text": "She was thirty years old and had spent all of them in this village except four."
  },
  {
   "p": 11,
   "s": 1,
   "start": 94.09,
   "end": 103.51,
   "text": "The man standing on the square was thirty-two and had spent his everywhere there was to spend them, and she could see from the window, before he had said a word to her, that it had not worked."
  }
 ]
}